<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Pages carrying the menu get the zero_megamenu cache tag, so a change in Content > Mega Menu cleans them. -->
    <type name="Magento\Theme\Block\Html\Topmenu">
        <plugin name="zero_megamenu_identities" type="Zero\MegaMenu\Plugin\TopmenuIdentities"/>
    </type>
</config>
